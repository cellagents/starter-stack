# Copy to .env, drop at least one provider key, and `docker compose up --build`.
#
# Only ANTHROPIC_API_KEY and OPENAI_API_KEY actually need your attention;
# everything else is a safe local-dev default. The compose stack binds all
# ports to 127.0.0.1 so nothing is exposed to your LAN.

# --- Model providers (one is enough; LiteLLM only uses the keys that match
# the models you actually invoke). ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local-dev defaults you probably don't need to touch ---
ADMIN_PASS=local-dev
LITELLM_MASTER_KEY=sk-local-master
LITELLM_SALT_KEY=sk-local-salt
LLM_DEFAULT_MODEL=claude-sonnet-4-6
LLM_MODELS=claude-haiku-4-5,claude-sonnet-4-6,claude-opus-4-7,gpt-4o-mini,gpt-4o
